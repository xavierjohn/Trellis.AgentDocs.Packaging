{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xavierjohn/Trellis.AgentDocs.Packaging/blob/main/Trellis.Guidance.Reader/docs/reference-manifest-v1.schema.json",
  "title": "Experimental NuGet package guidance manifest, version 1 (preview)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documents"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "usage"],
        "properties": {
          "path": { "$ref": "#/$defs/packagePath" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "usage": { "enum": ["required", "onDemand", "supporting"] },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}]*\\S[^\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}]*$",
            "description": "One line. Readers also enforce a limit of 200 Unicode scalar values counted after NFC normalization; JSON Schema cannot express that, so it is not a maxLength here."
          }
        },
        "if": { "properties": { "usage": { "enum": ["required", "onDemand"] } } },
        "then": { "required": ["description"] }
      }
    },
    "documentReferences": {
      "type": "array",
      "description": "Virtual package-relative Markdown paths that ordinary Markdown links can use to reach a declared document in another restored package.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "packageId", "documentPath"],
        "properties": {
          "path": { "$ref": "#/$defs/markdownPackagePath" },
          "packageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "documentPath": { "$ref": "#/$defs/markdownPackagePath" }
        }
      }
    },
    "publisherMetadata": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$": {}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        { "not": { "pattern": "\\\\" } },
        { "not": { "pattern": "(^|/)[.][gG][iI][tT][hH][uU][bB](/|$)" } }
      ],
      "description": "Package-relative path using forward slashes and no .github segment; additional portability, traversal, alias and link checks in the specification apply."
    },
    "markdownPackagePath": {
      "allOf": [
        { "$ref": "#/$defs/packagePath" },
        { "pattern": "\\.[mM][dD]$" }
      ]
    }
  }
}
