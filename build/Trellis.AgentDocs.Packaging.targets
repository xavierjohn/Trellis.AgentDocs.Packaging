<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Writes guidance/reference-manifest.json. The manifest is built by a task, not by MSBuild property functions,
    because publisher text (quotes, backslashes, apostrophes, percent signs) must never be embedded in quoted
    property-function arguments or path-normalised by MSBuild. The task applies the same description rules as the
    reader: trimmed, NFC-normalised, not blank, no control/format/line/paragraph-separator characters, and at most
    200 Unicode scalar values after normalisation.
  -->
  <UsingTask TaskName="WriteAgentDocsGuidanceManifest" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ManifestFile ParameterType="System.String" Required="true" />
      <DocumentPath ParameterType="System.String" Required="true" />
      <Sha256 ParameterType="System.String" Required="true" />
      <Usage ParameterType="System.String" Required="true" />
      <Description ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Globalization" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Method" Language="cs"><![CDATA[
        public override bool Execute()
        {
            string description;
            try
            {
                description = (Description ?? "").Trim().Normalize(NormalizationForm.FormC);
            }
            catch (ArgumentException)
            {
                description = "";
            }

            var valid = description.Length > 0;
            var scalars = 0;
            for (var i = 0; valid && i < description.Length; i++)
            {
                var category = CharUnicodeInfo.GetUnicodeCategory(description, i);
                if (category == UnicodeCategory.Control || category == UnicodeCategory.Format ||
                    category == UnicodeCategory.LineSeparator || category == UnicodeCategory.ParagraphSeparator)
                    valid = false;
                if (char.IsHighSurrogate(description[i]) && i + 1 < description.Length &&
                    char.IsLowSurrogate(description[i + 1]))
                    i++;
                scalars++;
            }

            if (!valid || scalars > 200)
            {
                Log.LogError("PackageGuidanceDescription must be a single line of at most 200 characters, not blank, " +
                    "without control, format, or line-separator characters.");
                return false;
            }

            var json = new StringBuilder("{\"schemaVersion\":1,\"documents\":[{\"path\":");
            AppendString(json, DocumentPath);
            json.Append(",\"sha256\":");
            AppendString(json, Sha256);
            json.Append(",\"usage\":");
            AppendString(json, Usage);
            json.Append(",\"description\":");
            AppendString(json, description);
            json.Append("}]}");
            var directory = Path.GetDirectoryName(Path.GetFullPath(ManifestFile));
            if (!string.IsNullOrEmpty(directory))
                Directory.CreateDirectory(directory);
            File.WriteAllText(ManifestFile, json.ToString(), new UTF8Encoding(false));
            return true;
        }

        private static void AppendString(StringBuilder json, string value)
        {
            json.Append('"');
            foreach (var c in value)
            {
                if (c == '"')
                    json.Append("\\\"");
                else if (c == '\\')
                    json.Append("\\\\");
                else if (c < ' ')
                    json.Append("\\u").Append(((int)c).ToString("x4"));
                else
                    json.Append(c);
            }

            json.Append('"');
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
    Multi-document publishers declare PackageGuidanceItem items instead of the single-document properties:

      <PackageGuidanceItem Include="docs/start.md" PackagePath="guide/start.md" Usage="required"
                           Description="Read before using X." />

    Usage defaults to onDemand; a supporting document may omit its Description. The task packs nothing itself: it
    checks the same rules the reader and `agentdocs validate` apply (portable Markdown path, usage, description,
    no duplicates, at least one required or onDemand document), hashes each file and writes the manifest. Run
    `agentdocs validate` on the built package for the deeper checks (links, size, discoverability).
  -->
  <UsingTask TaskName="WriteAgentDocsGuidanceManifestFromItems" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ManifestFile ParameterType="System.String" Required="true" />
      <Documents ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <DocumentReferences ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="false" />
      <SourcePackageId ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Globalization" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Method" Language="cs"><![CDATA[
        public override bool Execute()
        {
            var ok = true;
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var prefixes = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            var paths = new List<string>();
            var entries = new List<string>();
            var referenceEntries = new List<string>();
            var anyListed = false;
            foreach (var item in Documents)
            {
                var source = item.GetMetadata("FullPath");
                var path = item.GetMetadata("PackagePath");
                var usage = item.GetMetadata("Usage");
                if (usage.Length == 0)
                    usage = "onDemand";
                var name = item.ItemSpec;

                if (!ValidPath(path))
                {
                    Log.LogError("PackageGuidanceItem '" + name + "': PackagePath '" + path + "' must be a portable relative Markdown path with forward slashes, no .github segments and no device names.");
                    ok = false;
                    continue;
                }

                if (!seen.Add(path.Normalize(NormalizationForm.FormC)))
                {
                    Log.LogError("PackageGuidanceItem '" + name + "': PackagePath '" + path + "' is listed more than once.");
                    ok = false;
                    continue;
                }

                // Every directory prefix must have one spelling (compared after NFC, ignoring case), because
                // consumers install into case-insensitive file systems and reject portable aliases.
                var segments = path.Split('/');
                string aliased = null;
                for (var i = 1; i <= segments.Length && aliased == null; i++)
                {
                    var original = string.Join("/", segments, 0, i);
                    var normalized = original.Normalize(NormalizationForm.FormC);
                    string previous;
                    if (prefixes.TryGetValue(normalized, out previous) && previous != original)
                        aliased = previous + "' and '" + original;
                    else
                        prefixes[normalized] = original;
                }

                if (aliased != null)
                {
                    Log.LogError("PackageGuidanceItem '" + name + "': PackagePath '" + path + "' collides with a differently spelled path ('" + aliased + "'); portable aliases are rejected.");
                    ok = false;
                    continue;
                }

                paths.Add(path.Normalize(NormalizationForm.FormC));

                if (usage != "required" && usage != "onDemand" && usage != "supporting")
                {
                    Log.LogError("PackageGuidanceItem '" + name + "': Usage must be required, onDemand or supporting.");
                    ok = false;
                    continue;
                }

                if (!File.Exists(source))
                {
                    Log.LogError("PackageGuidanceItem '" + name + "': missing guidance document " + source + ".");
                    ok = false;
                    continue;
                }

                string description = null;
                var raw = item.GetMetadata("Description");
                if (raw.Length > 0 || usage != "supporting")
                {
                    try { description = raw.Trim().Normalize(NormalizationForm.FormC); }
                    catch (ArgumentException) { description = ""; }
                    var valid = description.Length > 0;
                    var scalars = 0;
                    for (var i = 0; valid && i < description.Length; i++)
                    {
                        var category = CharUnicodeInfo.GetUnicodeCategory(description, i);
                        if (category == UnicodeCategory.Control || category == UnicodeCategory.Format ||
                            category == UnicodeCategory.LineSeparator || category == UnicodeCategory.ParagraphSeparator)
                            valid = false;
                        if (char.IsHighSurrogate(description[i]) && i + 1 < description.Length &&
                            char.IsLowSurrogate(description[i + 1]))
                            i++;
                        scalars++;
                    }

                    if (!valid || scalars > 200)
                    {
                        Log.LogError("PackageGuidanceItem '" + name + "': Description must be a single line of at most 200 characters, " +
                            (usage == "supporting" ? "" : "not blank (a " + usage + " document needs one), ") +
                            "without control, format, or line-separator characters.");
                        ok = false;
                        continue;
                    }
                }

                if (usage != "supporting")
                    anyListed = true;
                string hash;
                using (var stream = File.OpenRead(source))
                    hash = BitConverter.ToString(SHA256.Create().ComputeHash(stream)).Replace("-", "").ToLowerInvariant();

                var json = new StringBuilder("{\"path\":");
                AppendString(json, path);
                json.Append(",\"sha256\":");
                AppendString(json, hash);
                json.Append(",\"usage\":");
                AppendString(json, usage);
                if (description != null)
                {
                    json.Append(",\"description\":");
                    AppendString(json, description);
                }

                json.Append('}');
                entries.Add(json.ToString());
            }

            foreach (var item in DocumentReferences ?? new Microsoft.Build.Framework.ITaskItem[0])
            {
                var path = item.ItemSpec;
                var packageId = item.GetMetadata("PackageId");
                var documentPath = item.GetMetadata("DocumentPath");
                if (!ValidPath(path))
                {
                    Log.LogError("PackageGuidanceReference '" + path +
                        "': Include must be a portable relative Markdown path with forward slashes, no .github segments and no device names.");
                    ok = false;
                    continue;
                }

                if (!seen.Add(path.Normalize(NormalizationForm.FormC)))
                {
                    Log.LogError("PackageGuidanceReference '" + path +
                        "': Include collides with another guidance document or reference path.");
                    ok = false;
                    continue;
                }

                var segments = path.Split('/');
                string aliased = null;
                for (var i = 1; i <= segments.Length && aliased == null; i++)
                {
                    var original = string.Join("/", segments, 0, i);
                    var normalized = original.Normalize(NormalizationForm.FormC);
                    string previous;
                    if (prefixes.TryGetValue(normalized, out previous) && previous != original)
                        aliased = previous + "' and '" + original;
                    else
                        prefixes[normalized] = original;
                }

                if (aliased != null)
                {
                    Log.LogError("PackageGuidanceReference '" + path +
                        "' collides with a differently spelled path ('" + aliased +
                        "'); portable aliases are rejected.");
                    ok = false;
                    continue;
                }

                paths.Add(path.Normalize(NormalizationForm.FormC));
                if (!Regex.IsMatch(packageId, @"^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"))
                {
                    Log.LogError("PackageGuidanceReference '" + path +
                        "': PackageId must be a valid NuGet package ID of at most 100 ASCII characters.");
                    ok = false;
                    continue;
                }

                if (string.Equals(packageId, SourcePackageId, StringComparison.OrdinalIgnoreCase))
                {
                    Log.LogError("PackageGuidanceReference '" + path +
                        "': PackageId must not target the publishing package itself.");
                    ok = false;
                    continue;
                }

                if (!ValidPath(documentPath))
                {
                    Log.LogError("PackageGuidanceReference '" + path +
                        "': DocumentPath must be a portable relative Markdown path with forward slashes, no .github segments and no device names.");
                    ok = false;
                    continue;
                }

                var json = new StringBuilder("{\"path\":");
                AppendString(json, path);
                json.Append(",\"packageId\":");
                AppendString(json, packageId);
                json.Append(",\"documentPath\":");
                AppendString(json, documentPath);
                json.Append('}');
                referenceEntries.Add(json.ToString());
            }

            foreach (var path in paths)
            {
                foreach (var other in paths)
                {
                    if (other.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase))
                    {
                        Log.LogError("PackagePath '" + path + "' is also used as a directory by '" + other + "'.");
                        ok = false;
                    }
                }
            }

            if (ok && entries.Count > 0 && !anyListed)
            {
                Log.LogError("Guidance needs at least one required or onDemand PackageGuidanceItem; agents are never told about supporting documents on their own.");
                ok = false;
            }

            if (!ok)
                return false;
            var directory = Path.GetDirectoryName(Path.GetFullPath(ManifestFile));
            if (!string.IsNullOrEmpty(directory))
                Directory.CreateDirectory(directory);
            var manifest = "{\"schemaVersion\":1,\"documents\":[" + string.Join(",", entries) + "]";
            if (referenceEntries.Count > 0)
                manifest += ",\"documentReferences\":[" + string.Join(",", referenceEntries) + "]";
            File.WriteAllText(ManifestFile, manifest + "}", new UTF8Encoding(false));
            return true;
        }

        private static bool ValidPath(string path)
        {
            return Regex.IsMatch(path ?? "", @"^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*\.md$") &&
                !Regex.IsMatch(path, @"(^|/)[^/]+[.](/|$)|(?i)(^|/)([.]github|con|prn|aux|nul|com[1-9]|lpt[1-9])([.]|/|$)");
        }

        private static void AppendString(StringBuilder json, string value)
        {
            json.Append('"');
            foreach (var c in value)
            {
                if (c == '"')
                    json.Append("\\\"");
                else if (c == '\\')
                    json.Append("\\\\");
                else if (c < ' ')
                    json.Append("\\u").Append(((int)c).ToString("x4"));
                else
                    json.Append(c);
            }

            json.Append('"');
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GeneratePackageGuidanceManifestFromItems" BeforeTargets="_GetPackageFiles"
          Condition="'$(IsPackable)' != 'false' AND '@(PackageGuidanceItem)' != ''">
    <Error Condition="'$(PackageGuidanceDocument)' != '' OR '$(PackageGuidancePath)' != ''"
           Text="Use either PackageGuidanceItem items or PackageGuidanceDocument/PackageGuidancePath, not both." />
    <PropertyGroup>
      <_PackageGuidanceManifest>$(IntermediateOutputPath)reference-manifest.json</_PackageGuidanceManifest>
    </PropertyGroup>
    <WriteAgentDocsGuidanceManifestFromItems ManifestFile="$(_PackageGuidanceManifest)"
                                             Documents="@(PackageGuidanceItem)"
                                             DocumentReferences="@(PackageGuidanceReference)"
                                             SourcePackageId="$(PackageId)" />
    <ItemGroup>
      <None Include="@(PackageGuidanceItem)" Pack="true" />
      <None Include="$(_PackageGuidanceManifest)" Pack="true"
            PackagePath="guidance/reference-manifest.json" />
    </ItemGroup>
  </Target>

  <Target Name="ValidatePackageGuidanceReferenceForm" BeforeTargets="_GetPackageFiles"
          Condition="'$(IsPackable)' != 'false' AND '@(PackageGuidanceReference)' != '' AND '@(PackageGuidanceItem)' == ''">
    <Error Text="PackageGuidanceReference requires PackageGuidanceItem; use the item form instead of the single-document properties." />
  </Target>

  <Target Name="GeneratePackageGuidanceManifest" BeforeTargets="_GetPackageFiles"
          Condition="'$(IsPackable)' != 'false' AND '@(PackageGuidanceItem)' == '' AND
                     ('$(PackageGuidanceDocument)' != '' OR '$(PackageGuidancePath)' != '')">
    <PropertyGroup>
      <PackageGuidanceUsage Condition="'$(PackageGuidanceUsage)' == ''">onDemand</PackageGuidanceUsage>
    </PropertyGroup>
    <Error Condition="'$(PackageGuidanceDocument)' == '' OR '$(PackageGuidancePath)' == ''"
           Text="Set both PackageGuidanceDocument and PackageGuidancePath to publish guidance." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(PackageGuidancePath)', '^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*\.md$')) != 'True' OR
                      $([System.Text.RegularExpressions.Regex]::IsMatch('$(PackageGuidancePath)', '(^|/)[^/]+[.](/|$)|(?i)(^|/)([.]github|con|prn|aux|nul|com[1-9]|lpt[1-9])([.]|/|$)')) == 'True'"
           Text="PackageGuidancePath must be a portable relative Markdown path with forward slashes, no .github segments and no device names." />
    <Error Condition="'$(PackageGuidanceUsage)' != 'required' AND '$(PackageGuidanceUsage)' != 'onDemand'"
           Text="PackageGuidanceUsage must be required or onDemand." />
    <Error Condition="'$(PackageGuidanceDescription)' == ''"
           Text="Set PackageGuidanceDescription to one line that says when an agent should open the guide." />
    <Error Condition="!Exists('$(PackageGuidanceDocument)')"
           Text="Missing package guidance document $(PackageGuidanceDocument)." />
    <PropertyGroup>
      <_PackageGuidanceManifest>$(IntermediateOutputPath)reference-manifest.json</_PackageGuidanceManifest>
    </PropertyGroup>
    <GetFileHash Files="$(PackageGuidanceDocument)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_PackageGuidanceHash" />
    </GetFileHash>
    <WriteAgentDocsGuidanceManifest ManifestFile="$(_PackageGuidanceManifest)"
                                    DocumentPath="$(PackageGuidancePath)"
                                    Sha256="$(_PackageGuidanceHash.ToLowerInvariant())"
                                    Usage="$(PackageGuidanceUsage)"
                                    Description="$(PackageGuidanceDescription)" />
    <ItemGroup>
      <None Include="$(PackageGuidanceDocument)" Pack="true"
            PackagePath="$(PackageGuidancePath)" />
      <None Include="$(_PackageGuidanceManifest)" Pack="true"
            PackagePath="guidance/reference-manifest.json" />
    </ItemGroup>
  </Target>
</Project>
