<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="GeneratePackageGuidanceManifest" BeforeTargets="_GetPackageFiles"
          Condition="'$(IsPackable)' != 'false' AND
                     ('$(PackageGuidanceDocument)' != '' OR '$(PackageGuidancePath)' != '')">
    <Error Condition="'$(PackageGuidanceDocument)' == '' OR '$(PackageGuidancePath)' == ''"
           Text="Set both PackageGuidanceDocument and PackageGuidancePath to publish guidance." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(PackageGuidancePath)', '^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*\.md$')) != 'True' OR
                      $([System.Text.RegularExpressions.Regex]::IsMatch('$(PackageGuidancePath)', '(^|/)[^/]+[.](/|$)|(?i)(^|/)(con|prn|aux|nul|com[1-9]|lpt[1-9])([.]|/|$)')) == 'True'"
           Text="PackageGuidancePath must be a portable relative Markdown path with forward slashes and no device names." />
    <Error Condition="!Exists('$(PackageGuidanceDocument)')"
           Text="Missing package guidance document $(PackageGuidanceDocument)." />
    <PropertyGroup>
      <_PackageGuidanceManifest>$(IntermediateOutputPath)reference-manifest.json</_PackageGuidanceManifest>
    </PropertyGroup>
    <GetFileHash Files="$(PackageGuidanceDocument)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_PackageGuidanceHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(_PackageGuidanceManifest)" Overwrite="true" Encoding="UTF-8"
                      Lines='{"schemaVersion":1,"documents":[{"path":"$(PackageGuidancePath)","sha256":"$(_PackageGuidanceHash.ToLowerInvariant())"}],"entryPoints":["$(PackageGuidancePath)"]}' />
    <ItemGroup>
      <None Include="$(PackageGuidanceDocument)" Pack="true"
            PackagePath="$(PackageGuidancePath)" />
      <None Include="$(_PackageGuidanceManifest)" Pack="true"
            PackagePath="guidance/reference-manifest.json" />
    </ItemGroup>
  </Target>
</Project>
